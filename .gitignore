# ============================================
# GoGit Project - Git Ignore Rules
# ============================================

# ============================================
# Design & Documentation Files (Not for Version Control)
# ============================================
DESIGN_PATTERNS.md
*.design.md
*.architecture.md
*.draft.md
TODO.md
ROADMAP.md
NOTES.md
*.todo.md
*.notes.md

# Optimization & Planning Documents
OPTIMIZATION_PLAN.md
*.optimization.md
*.plan.md
PLANNING.md

# ============================================
# Go Build Artifacts
# ============================================
# Executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.*
*.coverprofile
*.prof
*.pprof
benchmarks/

# Dependency directories (remove if you use vendoring)
vendor/

# Go workspace file
go.work
go.work.sum

# ============================================
# IDE & Editor Files
# ============================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Kilo (AI 辅助工具)
.kilo/

# Vim
*.swp
*.swo
*~
*.vim
.vimrc

# Sublime Text
*.sublime-workspace
*.sublime-project

# Air (Go hot reload)
.air.toml

# ============================================
# OS Generated Files
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory

# ============================================
# Test Files (Per Project Specification)
# ============================================
# Go test files
*_test.go
test_*.go

# Shell test scripts
test_*.sh
*_test.sh

# Python test files
test_*.py
*_test.py
pytest_cache/
.pytest_cache/
.coverage
htmlcov/

# JavaScript/TypeScript test files
test_*.js
*.test.js
*.spec.js
test_*.ts
*.test.ts
*.spec.ts

# Test data directories
/testdata/
/test_data/
/tests/

# Test reports and artifacts
test-results/
test-reports/
junit.xml
test-report.html

# ============================================
# Build & Distribution
# ============================================
# Build output
build/
dist/
bin/
out/

# Docker
docker-compose.override.yml

# Kubernetes
*.secret.yaml
kubeconfig

# ============================================
# Logs & Temporary Files
# ============================================
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# ============================================
# Environment & Configuration
# ============================================
# Environment variables files (keep template)
.env
.env.local
.env.*.local
!.env.example
!.env.template

# Sensitive configuration
*.secret.json
*.secret.yaml
*.secret.yml
credentials.json
service-account.json

# ============================================
# Node.js & Frontend (adminWeb)
# ============================================
# Dependencies
node_modules/
pnpm-lock.yaml.lock

# Build output
adminWeb/dist/
adminWeb/.vite/

# Cache
adminWeb/.cache/
adminWeb/node_modules/.cache/

# Testing
adminWeb/coverage/
adminWeb/.nyc_output/

# ============================================
# Python & AI Service
# ============================================
# Byte-compiled / optimized / DLL files
ai/__pycache__/
ai/*.py[cod]
ai/*$py.class
ai-service/__pycache__/
ai-service/*.py[cod]

# Virtual environment
ai/venv/
ai/env/
ai/.venv
ai-service/venv/
ai-service/env/
ai-service/.venv

# Distribution / packaging
ai/dist/
ai/build/
ai/*.egg-info/
ai/*.egg
ai-service/dist/
ai-service/build/

# Jupyter Notebook
ai/*.ipynb_checkpoints

# mypy
ai/.mypy_cache/

# ============================================
# Protocol Buffers
# ============================================
# Generated files (keep source .proto files)
*.pb.go
*_pb2.py
*_pb2_grpc.py

# Note: Keep proto/ directory with .proto source files
# Generated code should be rebuilt via proto/gen.sh

# ============================================
# Certificates & Security (Production)
# ============================================
# TLS certificates (should be mounted in production)
/etc/certs/
etc/certs/
*.crt
*.key
*.pem
ca.crt
server.crt
client.crt

# Private keys
id_rsa
id_ed25519

# JWT secrets
jwt_secret.txt
secret_key.txt

# API keys
api_keys.json
keys/

# Note: Certificate generation scripts should be kept
# but actual cert files should not be committed

# ============================================
# Database
# ============================================
# SQLite databases
*.db
*.sqlite
*.sqlite3

# Database migrations (if using temporary files)
*.migration.tmp

# ============================================
# Redis & Cache
# ============================================
dump.rdb
temp-*.rdb

# ============================================
# Performance Profiling
# ============================================
cpu.prof
mem.prof
trace.out
block.prof
mutex.prof

# ============================================
# Temporary Development Files
# ============================================

# Compile commands
compile_commands.json

# ============================================
# End of .gitignore
# ============================================
