# ============================================
# Go 项目通用忽略规则
# ============================================

# Go 构建产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go 依赖管理
/vendor/
go.work
go.work.sum

# 测试相关
*.test
*_test.go
/test_*.sh
/test_*.py
/test_*.js
/tests/
/testdata/

# 测试覆盖率
coverage.out
coverage.txt
coverage.html
*.coverprofile

# 基准测试
*.prof
*.pprof
benchmarks/

# ============================================
# 日志和临时文件
# ============================================

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# ============================================
# IDE 配置
# ============================================

# VS Code
.vscode/
*.code-workspace

# Kilo (AI 辅助工具)
.kilo/

# GoLand
.idea/
*.iml

# Vim
*.vim
.vimrc

# ============================================
# 环境配置（敏感信息）
# ============================================

# 环境变量文件
.env
.env.local
.env.*.local
!.env.example

# 证书和密钥
*.pem
*.key
*.crt
*.cert
etc/certs/

# ============================================
# 数据库文件
# ============================================

*.db
*.sqlite
*.sqlite3

# ============================================
# Docker
# ============================================

docker-compose.override.yml

# ============================================
# 微服务特定忽略
# ============================================

# Gateway 测试脚本
gateway/test_*.sh
gateway/docs/anti_replay_example.md
gateway/docs/ANTI_REPLAY_SUMMARY.md

# User 服务测试
user/test_*.sh

# Admin 服务测试
admin/test_*.sh

# AI 服务测试
ai-service/test_*.py
ai-service/test_*.sh
