# AI Service Environment Configuration (Production)
# WARNING: This file contains sensitive information. Do NOT commit to version control!

# ============================================
# Service Configuration
# ============================================
SERVICE_NAME=ai-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8003
GRPC_PORT=9003
SERVICE_VERSION=1.0.0

# ============================================
# Database Configuration (MySQL)
# ============================================
DB_DRIVER=mysql
DB_HOST=mysql-prod.internal
DB_PORT=3306
DB_USERNAME=ai_service_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=ai_db
DB_MAX_IDLE_CONNS=20
DB_MAX_OPEN_CONNS=200
DB_CONN_MAX_LIFETIME=3600

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis-prod.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_DB=0
REDIS_POOL_SIZE=200
REDIS_CLUSTER_ADDRESSES=

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_HERE
JWT_EXPIRE=24h

# ============================================
# Consul Configuration
# ============================================
CONSUL_HOST=consul-prod.internal
CONSUL_PORT=8500
CONSUL_TOKEN=CHANGE_ME_TO_CONSUL_ACL_TOKEN
CONSUL_SCHEME=https
CONSUL_CHECK_INTERVAL=10s
CONSUL_CHECK_TIMEOUT=5s
CONSUL_TTL=30s
CONSUL_DEREGISTER_CRITICAL_AFTER=90s
CONSUL_KEEPALIVE_INTERVAL=10s
CONSUL_ADDRESSES=

# ============================================
# Logger Configuration
# ============================================
LOG_LEVEL=warn
LOG_FORMAT=json

# ============================================
# CORS Configuration
# ============================================
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=https://yourdomain.com
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_EXPOSE_HEADERS=Content-Length,Content-Type
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12

# ============================================
# AI Model Configuration
# ============================================
AI_MODEL_PROVIDER=openai
AI_API_KEY=sk-prod-key-CHANGE_ME_TO_YOUR_ACTUAL_KEY
AI_MODEL=gpt-4-turbo
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ============================================
# Shutdown Configuration
# ============================================
SHUTDOWN_TIMEOUT=10s

# ============================================
# TLS/mTLS Configuration (Production - REQUIRED)
# ============================================
GRPC_USE_TLS=true
GRPC_INSECURE_SKIP_VERIFY=false
GRPC_CERT_FILE=/etc/certs/ai-service/client.crt
GRPC_KEY_FILE=/etc/certs/ai-service/client.key
GRPC_CA_FILE=/etc/certs/ai-service/ca.crt
GRPC_SERVER_NAME=ai-service
